@model HRMSystem.Models.NHANVIEN

@{
    ViewBag.Title = "Thêm Mới Hồ Sơ Nhân Viên";
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading">THÊM MỚI HỒ SƠ NHÂN VIÊN</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <table class="table-exact">
            <!-- 1. THÔNG TIN CÁ NHÂN -->
            <thead>
                <tr>
                    <th colspan="2" class="sec-title">THÔNG TIN CÁ NHÂN</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="sec-label">Mã nhân viên <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.MANHANVIEN, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ví dụ: NV051", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.MANHANVIEN, "", new { @class = "text-danger" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Họ và tên <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.HOTEN, new { htmlAttributes = new { @class = "form-control", @placeholder = "Nhập họ và tên đầy đủ", @required = "required" } })
                        @Html.ValidationMessageFor(model => model.HOTEN, "", new { @class = "text-danger" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Giới tính</td>
                    <td class="sec-value">
                        @Html.DropDownListFor(model => model.GIOITINH, new SelectList(new[] { "Nam", "Nu" }), new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ngày sinh</td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.NGAYSINH, new { @class = "form-control", @type = "date" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Số điện thoại</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.SODIENTHOAI, new { htmlAttributes = new { @class = "form-control", @placeholder = "Số điện thoại di động" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Email</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.EMAIL, new { htmlAttributes = new { @class = "form-control", @type = "email", @placeholder = "Địa chỉ email liên hệ" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Địa chỉ</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIACHI, new { htmlAttributes = new { @class = "form-control", @placeholder = "Nơi ở hiện tại" } })
                    </td>
                </tr>

                <!-- 2. VAI TRÒ HIỆN TẠI -->
                <tr>
                    <th colspan="2" class="sec-title">VAI TRÒ HIỆN TẠI</th>
                </tr>
                <tr>
                    <td class="sec-label">Phòng ban <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.DropDownList("PHONGBANID", null, htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Chức vụ</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.CHUCVU, new { htmlAttributes = new { @class = "form-control", @placeholder = "Chức vụ đảm nhiệm" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ngày vào làm</td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.NGAYVAOLAM, new { @class = "form-control", @type = "date" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Trạng thái</td>
                    <td class="sec-value">
                        @Html.DropDownListFor(model => model.TRANGTHAI, new SelectList(new[] { "Dang lam viec", "Da nghi viec", "Nghi thai san" }), new { @class = "form-control" })
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Hủy bỏ</a>
            <button type="submit" class="btn" style="background-color: #2e7d32; color: #fff; font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-plus"></i> Thêm mới nhân viên
            </button>
        </div>
    }
</div>
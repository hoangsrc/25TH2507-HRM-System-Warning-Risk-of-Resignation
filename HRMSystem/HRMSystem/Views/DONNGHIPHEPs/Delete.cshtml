@model HRMSystem.Models.DONNGHIPHEP

@{
    ViewBag.Title = "Xóa Đơn Nghỉ Phép";
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading-delete">XÁC NHẬN XÓA ĐƠN NGHỈ PHÉP</h1>
    <div class="delete-warning-text">
        <i class="glyphicon glyphicon-warning-sign"></i>
        Bạn có chắc muốn xóa đơn nghỉ phép của nhân viên <strong>@(Model.NHANVIEN != null ? Model.NHANVIEN.HOTEN : "")</strong>?
    </div>

    <table class="table-exact">
        <thead>
            <tr>
                <th colspan="2" class="sec-title">CHI TIẾT ĐƠN NGHỈ</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="sec-label">Nhân viên</td>
                <td class="sec-value" style="font-weight: 600;">
                    @(Model.NHANVIEN != null ? Model.NHANVIEN.HOTEN : "-")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Loại nghỉ phép</td>
                <td class="sec-value">@Model.LOAINGHIPHEP</td>
            </tr>
            <tr>
                <td class="sec-label">Thời gian</td>
                <td class="sec-value">
                    Từ @Model.TUNGAY.ToString("dd/MM/yyyy") đến @Model.DENNGAY.ToString("dd/MM/yyyy")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Trạng thái</td>
                <td class="sec-value">@Model.TRANGTHAI</td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Không, quay lại</a>
            <button type="submit" class="btn btn-danger" style="font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-trash"></i> Xác nhận xóa
            </button>
        </div>
    }
</div>
@model IEnumerable<HRMSystem.Models.DONNGHIPHEP>

@{
    ViewBag.Title = "Quản Lý Nghỉ Phép";
}

<div class="hrm-card">
    <div class="hrm-header">
        <div>
            <h3 style="margin: 0; font-weight: 700; color: #1e282d;">
                <i class="glyphicon glyphicon-calendar" style="color: #b45309; margin-right: 8px;"></i>DANH SÁCH ĐƠN NGHỈ PHÉP
            </h3>
            <span style="color: #64748b; font-size: 13px;">
                Tổng số đơn: <strong style="color: #0f172a;">@Model.Count()</strong> đơn xin nghỉ
            </span>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <input type="text" id="searchInput" onkeyup="searchTable()" class="form-control"
                   placeholder="🔍 Tìm nhân viên, loại nghỉ, trạng thái..."
                   style="width: 250px; border-radius: 6px; font-size: 13px;">

            <a href="@Url.Action("Create")" class="btn btn-success" style="border-radius: 6px; font-weight: 600; white-space: nowrap;">
                <i class="glyphicon glyphicon-plus"></i> Tạo đơn nghỉ phép
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table hrm-table" id="leaveTable">
            <thead>
                <tr>
                    <th class="nowrap">Nhân viên xin nghỉ</th>
                    <th class="nowrap">Loại nghỉ phép</th>
                    <th class="text-center nowrap">Từ ngày</th>
                    <th class="text-center nowrap">Đến ngày</th>
                    <th>Lý do xin nghỉ</th>
                    <th class="text-center nowrap">Ngày nộp đơn</th>
                    <th class="text-center nowrap" style="width: 130px;">Trạng thái</th>
                    <th class="text-center nowrap" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="nowrap">
                            <strong style="color: #0f172a;">
                                @(item.NHANVIEN != null ? item.NHANVIEN.HOTEN : "-")
                            </strong>
                            <small style="color: #64748b; margin-left: 4px;">
                                (@(item.NHANVIEN != null ? item.NHANVIEN.MANHANVIEN : ""))
                            </small>
                        </td>
                        <td class="nowrap">
                            @Html.DisplayFor(modelItem => item.LOAINGHIPHEP)
                        </td>
                        <td class="text-center nowrap">
                            @item.TUNGAY.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center nowrap">
                            @item.DENNGAY.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.LYDO)
                        </td>
                        <td class="text-center nowrap">
                            @item.NGAYTAO.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center nowrap">
                            @if (item.TRANGTHAI == "Da duyet")
                            {
                                <span class="status-badge">Đã duyệt</span>
                            }
                            else if (item.TRANGTHAI == "Tu choi")
                            {
                                <span class="status-badge" style="background:#fee2e2; color:#b91c1c; border-color:#fecaca;">Từ chối</span>
                            }
                            else
                            {
                                <span class="status-badge" style="background:#fef3c7; color:#92400e; border-color:#fde68a;">Chờ duyệt</span>
                            }
                        </td>
                        <td class="text-center nowrap">
                            <a href="@Url.Action("Edit", new { id = item.DONNGHIPHEPID })" class="action-btn btn-edit" title="Sửa / Duyệt">Sửa</a>
                            <a href="@Url.Action("Details", new { id = item.DONNGHIPHEPID })" class="action-btn btn-view" title="Xem">Xem</a>
                            <a href="@Url.Action("Delete", new { id = item.DONNGHIPHEPID })" class="action-btn btn-del" title="Xóa">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function searchTable() {
        var input = document.getElementById("searchInput");
        var table = document.getElementById("leaveTable");

        if (input instanceof HTMLInputElement && table) {
            var filter = input.value.toLowerCase();
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var text = tr[i].textContent || tr[i].innerText || "";
                if (text.toLowerCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
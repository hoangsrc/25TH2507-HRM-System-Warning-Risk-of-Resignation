@model HRMSystem.Models.PHONGBAN

@{
    ViewBag.Title = "Xác Nhận Xóa Phòng Ban - " + Model.TENPHONGBAN;
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading-delete">XÁC NHẬN XÓA PHÒNG BAN</h1>
    <div class="delete-warning-text">
        <i class="glyphicon glyphicon-warning-sign"></i>
        Bạn có chắc chắn muốn xóa phòng ban <strong>@Model.TENPHONGBAN</strong> khỏi hệ thống không?
    </div>

    <table class="table-exact">
        <thead>
            <tr>
                <th colspan="2" class="sec-title">THÔNG TIN PHÒNG BAN</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="sec-label">Mã phòng ban</td>
                <td class="sec-value" style="font-weight: bold; color: #1a365d;">PB00@Model.PHONGBANID</td>
            </tr>
            <tr>
                <td class="sec-label">Tên phòng ban</td>
                <td class="sec-value" style="font-weight: 600;">@Model.TENPHONGBAN</td>
            </tr>
            <tr>
                <td class="sec-label">Mô tả</td>
                <td class="sec-value">@Model.MOTA</td>
            </tr>
            <tr>
                <td class="sec-label">Trạng thái</td>
                <td class="sec-value">
                    @(Model.DANGHOATDONG ? "Đang hoạt động" : "Tạm ngưng hoạt động")
                </td>
            </tr>
        </tbody>
    </table>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Không, quay lại</a>
            <button type="submit" class="btn btn-danger" style="font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-trash"></i> Xác nhận xóa vĩnh viễn
            </button>
        </div>
    }
</div>
@model HRMSystem.Models.CHAMCONG

@{
    ViewBag.Title = "Ghi Nhận Chấm Công Mới";
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading">GHI NHẬN CHẤM CÔNG</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <table class="table-exact">
            <thead>
                <tr>
                    <th colspan="2" class="sec-title">THÔNG TIN ĐIỂM DANH</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="sec-label">Nhân viên <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.DropDownList("NHANVIENID", null, htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ngày làm việc <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.NGAYCHAMCONG, new { @class = "form-control", @type = "date", @required = "required" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Giờ vào</td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.GIOVAO, new { @class = "form-control", @type = "datetime-local" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Giờ ra</td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.GIORA, new { @class = "form-control", @type = "datetime-local" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Trạng thái</td>
                    <td class="sec-value">
                        @Html.DropDownListFor(model => model.TRANGTHAI, new SelectList(new[] { "Dung gio", "Di tre", "Ve som", "Nghi co phep", "Nghi khong phep" }), new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ghi chú</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.GHICHU, new { htmlAttributes = new { @class = "form-control", @placeholder = "Lý do đi trễ, giải trình..." } })
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Hủy bỏ</a>
            <button type="submit" class="btn" style="background-color: #2e7d32; color: #fff; font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-plus"></i> Lưu chấm công
            </button>
        </div>
    }
</div>
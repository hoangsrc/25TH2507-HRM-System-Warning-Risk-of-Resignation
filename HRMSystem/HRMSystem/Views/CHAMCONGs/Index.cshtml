@model IEnumerable<HRMSystem.Models.CHAMCONG>

@{
    ViewBag.Title = "Quản Lý Chấm Công";
}

<div class="hrm-card">
    <div class="hrm-header">
        <div>
            <h3 style="margin: 0; font-weight: 700; color: #1e282d;">
                <i class="glyphicon glyphicon-check" style="color: #b45309; margin-right: 8px;"></i>GHI NHẬN CHẤM CÔNG
            </h3>
            <span style="color: #64748b; font-size: 13px;">
                Tổng số bản ghi: <strong style="color: #0f172a;">@Model.Count()</strong> lượt
            </span>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
            <input type="text" id="searchInput" onkeyup="searchTable()" class="form-control"
                   placeholder="🔍 Tìm nhân viên, ngày, trạng thái..."
                   style="width: 250px; border-radius: 6px; font-size: 13px;">

            <a href="@Url.Action("Create")" class="btn btn-success" style="border-radius: 6px; font-weight: 600; white-space: nowrap;">
                <i class="glyphicon glyphicon-plus"></i> Ghi nhận chấm công
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table hrm-table" id="attendanceTable">
            <thead>
                <tr>
                    <th class="nowrap">Nhân viên</th>
                    <th class="text-center nowrap">Ngày làm việc</th>
                    <th class="text-center nowrap">Giờ vào</th>
                    <th class="text-center nowrap">Giờ ra</th>
                    <th class="text-center nowrap">Trạng thái</th>
                    <th>Ghi chú</th>
                    <th class="text-center nowrap" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="nowrap">
                            <strong style="color: #0f172a;">
                                @(item.NHANVIEN != null ? item.NHANVIEN.HOTEN : "-")
                            </strong>
                            <small style="color: #64748b; margin-left: 4px;">
                                (@(item.NHANVIEN != null ? item.NHANVIEN.MANHANVIEN : ""))
                            </small>
                        </td>
                        <td class="text-center nowrap">
                            @item.NGAYCHAMCONG.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center nowrap" style="font-weight: 600; color: #15803d;">
                            @(item.GIOVAO.HasValue ? item.GIOVAO.Value.ToString("HH:mm") : "-")
                        </td>
                        <td class="text-center nowrap" style="font-weight: 600; color: #b45309;">
                            @(item.GIORA.HasValue ? item.GIORA.Value.ToString("HH:mm") : "-")
                        </td>
                        <td class="text-center nowrap">
                            <span class="status-badge">
                                @Html.DisplayFor(modelItem => item.TRANGTHAI)
                            </span>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.GHICHU)
                        </td>
                        <td class="text-center nowrap">
                            <a href="@Url.Action("Edit", new { id = item.CHAMCONGID })" class="action-btn btn-edit" title="Sửa">Sửa</a>
                            <a href="@Url.Action("Details", new { id = item.CHAMCONGID })" class="action-btn btn-view" title="Xem">Xem</a>
                            <a href="@Url.Action("Delete", new { id = item.CHAMCONGID })" class="action-btn btn-del" title="Xóa">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function searchTable() {
        var input = document.getElementById("searchInput");
        var table = document.getElementById("attendanceTable");

        if (input instanceof HTMLInputElement && table) {
            var filter = input.value.toLowerCase();
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var text = tr[i].textContent || tr[i].innerText || "";
                if (text.toLowerCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
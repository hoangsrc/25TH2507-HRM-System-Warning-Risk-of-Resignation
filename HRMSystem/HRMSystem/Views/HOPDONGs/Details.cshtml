@model HRMSystem.Models.HOPDONG

@{
    ViewBag.Title = "Chi Tiết Hợp Đồng - " + Model.SOHOPDONG;
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
    <div>
        <button onclick="window.print()" class="btn btn-sm" style="background-color: #37474f; color: #fff; font-weight: 600; margin-right: 5px;">
            <i class="glyphicon glyphicon-print"></i> In / Xuất PDF
        </button>
        <a href="@Url.Action("Edit", new { id = Model.HOPDONGID })" class="btn btn-sm" style="background-color: #1e282d; color: #fff; font-weight: 600;">
            <i class="glyphicon glyphicon-pencil"></i> Chỉnh sửa
        </a>
    </div>
</div>

<div class="profile-container">
    <h1 class="profile-heading">HỢP ĐỒNG LAO ĐỘNG</h1>

    <table class="table-exact">
        <!-- 1. THÔNG TIN HỢP ĐỒNG -->
        <thead>
            <tr>
                <th colspan="2" class="sec-title">THÔNG TIN HỢP ĐỒNG</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="sec-label">Số hợp đồng</td>
                <td class="sec-value" style="font-weight: bold; color: #1a365d;">@Model.SOHOPDONG</td>
            </tr>
            <tr>
                <td class="sec-label">Loại hợp đồng</td>
                <td class="sec-value" style="font-weight: 600;">@Model.LOAIHOPDONG</td>
            </tr>
            <tr>
                <td class="sec-label">Từ ngày (Hiệu lực)</td>
                <td class="sec-value">@Model.TUNGAY.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr>
                <td class="sec-label">Đến ngày (Hết hạn)</td>
                <td class="sec-value">
                    @(Model.DENNGAY.HasValue ? Model.DENNGAY.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Mức lương cơ bản</td>
                <td class="sec-value" style="font-weight: 700; color: #2e7d32;">
                    @Model.MUCLUONG.ToString("N0") VNĐ
                </td>
            </tr>
            <tr>
                <td class="sec-label">Trạng thái hợp đồng</td>
                <td class="sec-value">
                    <span class="status-badge">@Model.TRANGTHAI</span>
                </td>
            </tr>

            <!-- 2. THÔNG TIN NHÂN VIÊN KÝ KẾT -->
            <tr>
                <th colspan="2" class="sec-title">THÔNG TIN NHÂN VIÊN KÝ KẾT</th>
            </tr>
            <tr>
                <td class="sec-label">Mã nhân viên</td>
                <td class="sec-value" style="font-weight: bold; color: #1a365d;">
                    @(Model.NHANVIEN != null ? Model.NHANVIEN.MANHANVIEN : "-")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Họ và tên</td>
                <td class="sec-value" style="font-weight: 600;">
                    @(Model.NHANVIEN != null ? Model.NHANVIEN.HOTEN : "-")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Phòng ban</td>
                <td class="sec-value">
                    @(Model.NHANVIEN != null && Model.NHANVIEN.PHONGBAN != null ? Model.NHANVIEN.PHONGBAN.TENPHONGBAN : "-")
                </td>
            </tr>
            <tr>
                <td class="sec-label">Chức vụ đảm nhiệm</td>
                <td class="sec-value">
                    @(Model.NHANVIEN != null ? Model.NHANVIEN.CHUCVU : "-")
                </td>
            </tr>
        </tbody>
    </table>
</div>
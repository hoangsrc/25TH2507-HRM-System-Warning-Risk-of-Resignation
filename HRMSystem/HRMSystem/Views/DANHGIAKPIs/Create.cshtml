@model HRMSystem.Models.DANHGIAKPI

@{
    ViewBag.Title = "Thêm Đánh Giá KPI Mới";
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading">GHI NHẬN ĐÁNH GIÁ KPI</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <table class="table-exact">
            <thead>
                <tr>
                    <th colspan="2" class="sec-title">TIÊU CHÍ ĐÁNH GIÁ NHÂN SỰ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="sec-label">Nhân viên <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.DropDownList("NHANVIENID", null, htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Kỳ đánh giá <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.DropDownListFor(model => model.KYDANHGIA, new SelectList(new[] { "Q1-2026", "Q2-2026", "Q3-2026", "Q4-2026", "Nam-2026" }), new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm hiệu suất (0 - 5.0)</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMHIEUSUAT, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5", @placeholder = "Ví dụ: 4.5" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm chuyên cần (0 - 5.0)</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMCHUYENCAN, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5", @placeholder = "Ví dụ: 4.8" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm tổng kết (0 - 5.0)</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMTONGKET, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5", @placeholder = "Ví dụ: 4.6" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Nhận xét & Đánh giá</td>
                    <td class="sec-value">
                        @Html.TextAreaFor(model => model.NHANXET, new { @class = "form-control", @rows = "3", @style = "height: auto;", @placeholder = "Nhận xét ưu điểm, mặt cần cải thiện..." })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ngày đánh giá <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.NGAYDANHGIA, new { @class = "form-control", @type = "date", @required = "required" })
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Hủy bỏ</a>
            <button type="submit" class="btn" style="background-color: #2e7d32; color: #fff; font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-plus"></i> Lưu đánh giá KPI
            </button>
        </div>
    }
</div>
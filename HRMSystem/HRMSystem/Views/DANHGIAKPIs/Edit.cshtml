@model HRMSystem.Models.DANHGIAKPI

@{
    ViewBag.Title = "Chỉnh Sửa Đánh Giá KPI";
}

<div class="btn-toolbar-custom">
    <a href="@Url.Action("Index")" class="btn btn-default btn-sm" style="border: 1px solid #b0bec5; font-weight: 600;">
        <i class="glyphicon glyphicon-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="profile-container">
    <h1 class="profile-heading">CẬP NHẬT ĐÁNH GIÁ KPI</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.DANHGIAID)

        <table class="table-exact">
            <thead>
                <tr>
                    <th colspan="2" class="sec-title">TIÊU CHÍ ĐÁNH GIÁ NHÂN SỰ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="sec-label">Nhân viên</td>
                    <td class="sec-value">
                        @Html.DropDownList("NHANVIENID", null, htmlAttributes: new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Kỳ đánh giá <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.DropDownListFor(model => model.KYDANHGIA, new SelectList(new[] { "Q1-2026", "Q2-2026", "Q3-2026", "Q4-2026", "Nam-2026" }, Model.KYDANHGIA), new { @class = "form-control" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm hiệu suất</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMHIEUSUAT, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm chuyên cần</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMCHUYENCAN, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Điểm tổng kết</td>
                    <td class="sec-value">
                        @Html.EditorFor(model => model.DIEMTONGKET, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "0.1", @min = "0", @max = "5" } })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Nhận xét & Đánh giá</td>
                    <td class="sec-value">
                        @Html.TextAreaFor(model => model.NHANXET, new { @class = "form-control", @rows = "3", @style = "height: auto;" })
                    </td>
                </tr>
                <tr>
                    <td class="sec-label">Ngày đánh giá <span class="text-danger">*</span></td>
                    <td class="sec-value">
                        @Html.TextBoxFor(model => model.NGAYDANHGIA, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @required = "required" })
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 25px; text-align: right;">
            <a href="@Url.Action("Index")" class="btn btn-default" style="border: 1px solid #b0bec5; font-weight: 600; margin-right: 8px;">Hủy bỏ</a>
            <button type="submit" class="btn" style="background-color: #2e7d32; color: #fff; font-weight: bold; padding: 7px 25px;">
                <i class="glyphicon glyphicon-floppy-disk"></i> Lưu thay đổi
            </button>
        </div>
    }
</div>